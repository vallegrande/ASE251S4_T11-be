    {
      "name": "02 - Carrito invitado (sin login)",
      "item": [
        {
          "name": "01 - Crear o recuperar carrito de invitado",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cart",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cart"
              ]
            },
            "description": "La respuesta incluye sessionToken. El frontend debe guardarlo localmente y enviarlo como X-Session-Token en las siguientes operaciones."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Carrito invitado creado', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const cart = pm.response.json();",
                  "    pm.expect(cart.sessionToken).to.be.a('string');",
                  "    pm.collectionVariables.set('guestCartToken', cart.sessionToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Agregar producto sin login",
