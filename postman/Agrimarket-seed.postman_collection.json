        },
        {
          "name": "05 - Checkout con pago simulado (YAPE)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeId\": {{storeId}},\n  \"paymentMethod\": \"YAPE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/cart/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cart",
                "checkout"
              ]
            },
            "description": "Pago simulado: crea pago PENDING, referencia SIM y reserva/descuenta stock. No se cobra dinero. Cambia paymentMethod por TARJETA_CREDITO o PAGO_EFECTIVO; este último devuelve cipCode simulado y vence en 24 horas."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Checkout realizado', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.payment.simulated).to.eql(true);",
                  "    pm.collectionVariables.set('paymentId', String(body.payment.paymentId));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "06 - Simular confirmación del pago",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
