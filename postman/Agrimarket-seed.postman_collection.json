  "item": [
    {
      "name": "01 - MongoDB y datos maestros",
      "item": [
        {
          "name": "01 - Consultar Ubigeos precargados (ubigeos)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ubigeos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ubigeos"
              ]
            },
            "description": "UbigeoSeeder carga el catalogo al iniciar. Esta solicitud selecciona Imperial y guarda su id para registrar el cliente."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Ubigeos cargados y contiene Imperial', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const rows = pm.response.json();",
                  "    const imperial = rows.find(item => item.district === 'Imperial');",
                  "    pm.expect(imperial, 'Debe existir Imperial en el catalogo').to.exist;",
                  "    pm.collectionVariables.set('ubigeoId', String(imperial.id));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Iniciar sesion ADMIN",
