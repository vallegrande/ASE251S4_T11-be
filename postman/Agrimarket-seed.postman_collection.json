            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/payments/{{paymentId}}/simulate-confirmation",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "{{paymentId}}",
                "simulate-confirmation"
              ]
            },
            "description": "Simula que Yape, la tarjeta o el agente confirmó el pago. Cambia el estado a PAID y el pedido a PAID. No comunica con proveedores reales."
          }
        }
