          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login ADMIN correcto', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.role).to.eql('ADMIN');",
                  "    pm.collectionVariables.set('adminToken', body.token);",
